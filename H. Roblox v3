-- دالة مساعدة لإنشاء زر تفعيل (Toggle Button)
local function createToggle(text, callback)
	local state = false
	
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -6, 0, 38)
	btn.BackgroundColor3 = Color3.fromRGB(35, 35, 44)
	btn.Text = ""
	btn.Parent = contentFrame
	
	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 8)
	btnCorner.Parent = btn
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -60, 1, 0)
	label.Position = UDim2.new(0, 12, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(220, 220, 230)
	label.TextSize = 14
	label.Font = Enum.Font.GothamMedium
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = btn
	
	local indicator = Instance.new("Frame")
	indicator.Size = UDim2.new(0, 36, 0, 18)
	indicator.Position = UDim2.new(1, -46, 0.5, -9)
	indicator.BackgroundColor3 = Color3.fromRGB(70, 70, 85)
	indicator.Parent = btn
	
	local indCorner = Instance.new("UICorner")
	indCorner.CornerRadius = UDim.new(1, 0)
	indCorner.Parent = indicator
	
	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(0, 14, 0, 14)
	dot.Position = UDim2.new(0, 2, 0.5, -7)
	dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	dot.Parent = indicator
	
	local dotCorner = Instance.new("UICorner")
	dotCorner.CornerRadius = UDim.new(1, 0)
	dotCorner.Parent = dot
	
	btn.MouseButton1Click:Connect(function()
		state = not state
		local targetColor = state and Color3.fromRGB(0, 170, 120) or Color3.fromRGB(70, 70, 85)
		local targetPos = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
		
		TweenService:Create(indicator, TweenInfo.new(0.2), {BackgroundColor3 = targetColor}):Play()
		TweenService:Create(dot, TweenInfo.new(0.2), {Position = targetPos}):Play()
		
		if callback then
			callback(state)
		end
	end)
end

