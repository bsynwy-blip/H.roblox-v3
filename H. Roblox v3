local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- متغيرات التحكم بالمواصفات الإدارية
local showNamesAndHp = false
local locatePlayers = false
local nameTags = {}
local playerHighlights = {}

local function clearVisuals()
	for _, tag in pairs(nameTags) do
		if tag then tag:Destroy() end
	end
	table.clear(nameTags)

	for _, hl in pairs(playerHighlights) do
		if hl then hl:Destroy() end
	end
	table.clear(playerHighlights)
end

local function applyNameAndHp(targetPlayer)
	if targetPlayer == player then return end

	local function onCharacter(char)
		if nameTags[targetPlayer] then
			nameTags[targetPlayer]:Destroy()
			nameTags[targetPlayer] = nil
		end
		if not showNamesAndHp then return end

		local head = char:WaitForChild("Head", 5)
		local humanoid = char:WaitForChild("Humanoid", 5)
		if not head or not humanoid then return end

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "PlayerNameHpTag"
		billboard.Adornee = head
		billboard.Size = UDim2.new(0, 175, 0, 38)
		billboard.StudsOffset = Vector3.new(0, 2.6, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent = playerGui

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
		label.BackgroundTransparency = 0.2
		label.TextColor3 = Color3.fromRGB(240, 240, 245)
		label.TextScaled = true
		label.Font = Enum.Font.GothamBold
		label.Parent = billboard

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = label

		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(0, 170, 120)
		stroke.Thickness = 1
		stroke.Parent = label

		local function refreshHp()
			label.Text = string.format("%s | %d/%d HP", targetPlayer.DisplayName, math.floor(humanoid.Health), math.floor(humanoid.MaxHealth))
		end

		refreshHp()
		humanoid.HealthChanged:Connect(refreshHp)
		nameTags[targetPlayer] = billboard
	end

	if targetPlayer.Character then
		onCharacter(targetPlayer.Character)
	end
	targetPlayer.CharacterAdded:Connect(onCharacter)
end

local function applyLocationHighlight(targetPlayer)
	if targetPlayer == player then return end

	local function onCharacter(char)
		if playerHighlights[targetPlayer] then
			playerHighlights[targetPlayer]:Destroy()
			playerHighlights[targetPlayer] = nil
		end
		if not locatePlayers then return end

		local hl = Instance.new("Highlight")
		hl.Name = "PlayerLocationESP"
		hl.Adornee = char
		hl.FillColor = Color3.fromRGB(0, 170, 120)
		hl.OutlineColor = Color3.fromRGB(255, 255, 255)
		hl.FillTransparency = 0.55
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = playerGui

		playerHighlights[targetPlayer] = hl
	end

	if targetPlayer.Character then
		onCharacter(targetPlayer.Character)
	end
	targetPlayer.CharacterAdded:Connect(onCharacter)
end

local function refreshAdminFeatures()
	clearVisuals()
	for _, plr in ipairs(Players:GetPlayers()) do
		if showNamesAndHp then
			applyNameAndHp(plr)
		end
		if locatePlayers then
			applyLocationHighlight(plr)
		end
	end
end

Players.PlayerAdded:Connect(function(plr)
	if showNamesAndHp then
		applyNameAndHp(plr)
	end
	if locatePlayers then
		applyLocationHighlight(plr)
	end
end)

